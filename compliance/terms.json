{
  "version": 1,
  "note": "Canonical machine-readable copy of the term lists in COMPLIANCE.md. Edit both together. Not legal advice.",
  "tiers": {
    "1": {
      "label": "DRUG TRIGGER",
      "action": "block",
      "description": "Converts the product to an unapproved new drug. Never ships."
    },
    "2": {
      "label": "FTC SUBSTANTIATION RISK",
      "action": "block-unless-substantiated",
      "description": "Not a drug claim, but requires a substantiation record registered in compliance/substantiation.json."
    },
    "3": {
      "label": "SAFE",
      "action": "allow",
      "description": "Approved cosmetic language. Also used as an allowlist so approved phrases containing a blocked word are not flagged."
    }
  },

  "allowPhrases": [
    "leaves the scalp feeling clean",
    "leaves the scalp feeling refreshed",
    "leaves the scalp feeling balanced",
    "leaves the scalp feeling clean / refreshed / balanced",
    "leaves hair feeling clean",
    "waxy, not-clean feeling"
  ],

  "terms": [
    { "term": "dandruff", "tier": 1, "reason": "Named OTC monograph condition. Any claim to address it requires a monograph active and a Drug Facts panel.", "replacement": "removes buildup" },
    { "term": "anti-dandruff", "tier": 1, "reason": "Explicit OTC drug category.", "replacement": "clarifies" },
    { "term": "flake", "tier": 1, "reason": "Reads as a dandruff/seborrheic dermatitis claim regardless of wording around it.", "replacement": "buildup" },
    { "term": "flakes", "tier": 1, "reason": "Reads as a dandruff/seborrheic dermatitis claim.", "replacement": "buildup" },
    { "term": "flaking", "tier": 1, "reason": "Reads as a dandruff/seborrheic dermatitis claim.", "replacement": "buildup" },
    { "term": "flaky", "tier": 1, "reason": "Reads as a dandruff/seborrheic dermatitis claim.", "replacement": "dry-feeling" },
    { "term": "itch", "tier": 1, "reason": "Symptom of a skin condition; treating it is a drug claim.", "replacement": "leaves the scalp feeling refreshed" },
    { "term": "itchy", "tier": 1, "reason": "Symptom of a skin condition.", "replacement": "leaves the scalp feeling refreshed" },
    { "term": "itching", "tier": 1, "reason": "Symptom of a skin condition.", "replacement": "leaves the scalp feeling refreshed" },
    { "term": "itchiness", "tier": 1, "reason": "Symptom of a skin condition.", "replacement": "leaves the scalp feeling refreshed" },
    { "term": "seborrheic", "tier": 1, "reason": "Named dermatological condition.", "replacement": "" },
    { "term": "seborrhea", "tier": 1, "reason": "Named dermatological condition.", "replacement": "" },
    { "term": "dermatitis", "tier": 1, "reason": "Named dermatological condition.", "replacement": "" },
    { "term": "eczema", "tier": 1, "reason": "Named dermatological condition.", "replacement": "" },
    { "term": "psoriasis", "tier": 1, "reason": "Named dermatological condition.", "replacement": "" },
    { "term": "fungal", "tier": 1, "reason": "Implies treatment of infection.", "replacement": "" },
    { "term": "antifungal", "tier": 1, "reason": "Explicit drug action.", "replacement": "" },
    { "term": "malassezia", "tier": 1, "reason": "Organism implicated in dandruff; naming it is a disease claim.", "replacement": "" },
    { "term": "yeast", "tier": 1, "reason": "Implies treatment of infection.", "replacement": "" },
    { "term": "scalp condition", "tier": 1, "reason": "'Condition' as a noun signals disease.", "replacement": "scalp feel" },
    { "term": "scalp disorder", "tier": 1, "reason": "'Disorder' signals disease.", "replacement": "scalp feel" },
    { "term": "inflammation", "tier": 1, "reason": "Physiological/disease process.", "replacement": "" },
    { "term": "inflamed", "tier": 1, "reason": "Physiological/disease process.", "replacement": "" },
    { "term": "anti-inflammatory", "tier": 1, "reason": "Explicit drug action.", "replacement": "" },
    { "term": "hair loss", "tier": 1, "reason": "Drug category; minoxidil/finasteride territory.", "replacement": "" },
    { "term": "thinning hair", "tier": 1, "reason": "Drug category.", "replacement": "adds volume" },
    { "term": "shedding", "tier": 1, "reason": "Drug category.", "replacement": "" },
    { "term": "alopecia", "tier": 1, "reason": "Named medical condition.", "replacement": "" },
    { "term": "balding", "tier": 1, "reason": "Drug category.", "replacement": "" },
    { "term": "regrow", "tier": 1, "reason": "Alters body structure/function.", "replacement": "" },
    { "term": "regrowth", "tier": 1, "reason": "Alters body structure/function.", "replacement": "" },
    { "term": "hair growth", "tier": 1, "reason": "Alters body structure/function.", "replacement": "" },
    { "term": "DHT", "tier": 1, "reason": "Hormonal mechanism claim.", "replacement": "" },
    { "term": "stimulates follicles", "tier": 1, "reason": "Alters body structure/function.", "replacement": "" },
    { "term": "follicle stimulation", "tier": 1, "reason": "Alters body structure/function.", "replacement": "" },
    { "term": "treats", "tier": 1, "reason": "Therapeutic verb. Cosmetics do not treat.", "replacement": "cleanses" },
    { "term": "treatment for", "tier": 1, "reason": "Therapeutic framing.", "replacement": "" },
    { "term": "cures", "tier": 1, "reason": "Therapeutic verb.", "replacement": "" },
    { "term": "heals", "tier": 1, "reason": "Therapeutic verb.", "replacement": "conditions" },
    { "term": "healing", "tier": 1, "reason": "Therapeutic framing.", "replacement": "conditioning" },
    { "term": "medicated", "tier": 1, "reason": "Explicit drug framing.", "replacement": "" },
    { "term": "antibacterial", "tier": 1, "reason": "Drug action claim.", "replacement": "" },
    { "term": "antimicrobial", "tier": 1, "reason": "Drug action claim. Note: describing a preservative's function in internal formulation records is fine; on consumer copy it is not.", "replacement": "" },
    { "term": "disinfects", "tier": 1, "reason": "Drug/pesticide action claim.", "replacement": "cleanses" },
    { "term": "therapeutic", "tier": 1, "reason": "Explicit drug framing.", "replacement": "" },

    { "term": "prevents", "tier": 1, "pattern": "prevent(?:s|ing)?\\W+(?:\\w+\\W+){0,3}?(?:dandruff|flakes?|flaking|itch(?:ing|iness)?|hair\\s+loss|shedding|balding|alopecia|breakage|damage|split\\s+ends|dermatitis|eczema|psoriasis|inflammation)", "reason": "'Prevents' plus a condition is a disease claim. 'Prevents frizz' is fine and is not matched by this rule.", "replacement": "helps guard against frizz" },

    { "term": "clean", "tier": 2, "reason": "'Clean beauty' is unregulated and heavily litigated. Approved only inside allowlisted sensory phrases such as 'leaves the scalp feeling clean'.", "replacement": "cleanses" },
    { "term": "non-toxic", "tier": 2, "reason": "FTC Green Guides: requires competent and reliable scientific evidence for the whole product.", "replacement": "" },
    { "term": "nontoxic", "tier": 2, "reason": "FTC Green Guides: requires competent and reliable scientific evidence.", "replacement": "" },
    { "term": "chemical-free", "tier": 2, "reason": "Literally false for any formulation. High-risk claim.", "replacement": "" },
    { "term": "100% natural", "tier": 2, "reason": "'Natural' is undefined by FDA for cosmetics; a percentage claim needs substantiation.", "replacement": "plant-derived" },
    { "term": "all natural", "tier": 2, "reason": "'Natural' is undefined by FDA for cosmetics.", "replacement": "plant-derived" },
    { "term": "safe", "tier": 2, "reason": "Blanket safety claims require substantiation and invite scrutiny.", "replacement": "gentle" },
    { "term": "clinically proven", "tier": 2, "reason": "Requires a clinical study on the finished product.", "replacement": "" },
    { "term": "dermatologist proven", "tier": 2, "reason": "Requires a study; 'proven' is stronger than 'tested'.", "replacement": "" },
    { "term": "dermatologist tested", "tier": 2, "reason": "Requires an actual dermatologist-supervised test report on file.", "replacement": "" },
    { "term": "repairs", "tier": 2, "reason": "Structural change claim; borderline drug language for hair and skin.", "replacement": "conditions" },
    { "term": "rebuilds", "tier": 2, "reason": "Structural change claim.", "replacement": "smooths" },
    { "term": "restores damage", "tier": 2, "reason": "Structural change claim.", "replacement": "softens" },
    { "term": "reverses damage", "tier": 2, "reason": "Structural change claim.", "replacement": "smooths" },

    { "term": "cleanses", "tier": 3, "scope": "hair" },
    { "term": "washes", "tier": 3, "scope": "hair" },
    { "term": "removes buildup", "tier": 3, "scope": "hair" },
    { "term": "clarifies", "tier": 3, "scope": "hair" },
    { "term": "purifies", "tier": 3, "scope": "hair" },
    { "term": "hydrates", "tier": 3, "scope": "hair" },
    { "term": "moisturizes", "tier": 3, "scope": "hair" },
    { "term": "conditions", "tier": 3, "scope": "hair" },
    { "term": "softens", "tier": 3, "scope": "hair" },
    { "term": "smooths", "tier": 3, "scope": "hair" },
    { "term": "detangles", "tier": 3, "scope": "hair" },
    { "term": "defines curls", "tier": 3, "scope": "hair" },
    { "term": "reduces frizz", "tier": 3, "scope": "hair" },
    { "term": "adds shine", "tier": 3, "scope": "hair" },
    { "term": "adds volume", "tier": 3, "scope": "hair" },
    { "term": "adds texture", "tier": 3, "scope": "hair" },
    { "term": "leaves hair feeling", "tier": 3, "scope": "hair" },
    { "term": "cleanses the scalp", "tier": 3, "scope": "scalp-cleanser-only" },
    { "term": "leaves the scalp feeling clean", "tier": 3, "scope": "scalp-cleanser-only" },
    { "term": "leaves the scalp feeling refreshed", "tier": 3, "scope": "scalp-cleanser-only" },
    { "term": "leaves the scalp feeling balanced", "tier": 3, "scope": "scalp-cleanser-only" },
    { "term": "lightweight", "tier": 3, "scope": "scalp-cleanser-only" },
    { "term": "non-stripping", "tier": 3, "scope": "scalp-cleanser-only" }
  ]
}
